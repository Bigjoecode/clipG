# Local PostgreSQL used by Prisma and future API database access.
DATABASE_URL=postgresql://clipgenius:clipgenius@localhost:5432/clipgenius

# Supabase Auth public configuration. The publishable key is safe for browser use;
# never put a Supabase secret/service-role key in a NEXT_PUBLIC variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Source-video uploads use a private Supabase Storage bucket and resumable TUS.
# The 50 MB default matches Supabase Free; raise it only after increasing the
# Supabase project's global file-size limit (paid plans support larger files).
SOURCE_VIDEO_BUCKET=clipgenius-source-media
SOURCE_VIDEO_MAX_BYTES=52428800

# Local Redis used by the background worker. Use a rediss:// URL for a hosted
# endpoint; the worker needs a plain TCP connection, not an HTTP REST proxy.
REDIS_URL=redis://localhost:6379

# Server-only Supabase secret key used by the worker to read private source media
# for analysis. It bypasses Storage row-level security: keep it out of the
# browser, out of any NEXT_PUBLIC variable, and out of version control.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Media probe tuning. Defaults are safe; raise MEDIA_PROBE_MAX_BYTES only
# alongside SOURCE_VIDEO_MAX_BYTES and the worker's available disk.
MEDIA_PROBE_ATTEMPTS=3
MEDIA_PROBE_CONCURRENCY=2
MEDIA_PROBE_MAX_BYTES=52428800
MEDIA_PROBE_TIMEOUT_MS=120000
UPLOAD_PENDING_MAX_AGE_HOURS=24

# Task 007 transcription. These keys are worker-only and must never use a
# NEXT_PUBLIC prefix. Only the selected provider's key is required.
#
# Both supported providers return timestamped SPEAKER segments. Task 008 content
# intelligence takes speaker data as an input, so do not point TRANSCRIPTION_MODEL
# at a model that only returns plain segments.
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=dg_replace_me
OPENAI_API_KEY=sk_replace_me
#
# Leave TRANSCRIPTION_MODEL unset to use each provider's diarizing default
# (deepgram: nova-2, openai: gpt-4o-transcribe-diarize).
# TRANSCRIPTION_MODEL=
TRANSCRIPTION_ATTEMPTS=3
TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_TIMEOUT_MS=600000
TRANSCRIPTION_MAX_AUDIO_BYTES=26214400
AUDIO_EXTRACTION_TIMEOUT_MS=300000

# Task 008 content intelligence runs in the background worker against a
# schema-constrained model. Only the selected provider's key is required.
#
#   gemini (default) - Gemini Interactions structured output; needs GEMINI_API_KEY.
#   openai           - OpenAI Structured Outputs, reuses OPENAI_API_KEY above.
#   anthropic        - Claude structured outputs; needs ANTHROPIC_API_KEY.
#
# A Claude Pro or Gemini Pro consumer subscription does NOT grant API access;
# each provider bills API usage separately.
#
# DATA HANDLING: read the selected service tier's terms before sending customer
# recordings. The worker sends transcript text, not video bytes.
CONTENT_INTELLIGENCE_PROVIDER=gemini
# ANTHROPIC_API_KEY=sk-ant-replace_me
# GEMINI_API_KEY=replace_me
#
# Leave the model unset to use each provider's default
# (openai: gpt-5.6-terra, anthropic: claude-opus-5, gemini: gemini-3.6-flash).
# Override only after evaluating schema-valid opportunity quality, latency, and cost on
# representative transcripts.
# CONTENT_INTELLIGENCE_MODEL=
CONTENT_INTELLIGENCE_ATTEMPTS=3
CONTENT_INTELLIGENCE_CONCURRENCY=1
CONTENT_INTELLIGENCE_TIMEOUT_MS=300000
CONTENT_INTELLIGENCE_MAX_TRANSCRIPT_CHARACTERS=200000

# Task 010 Creative Director. It uses the same Gemini account/key as Content
# Intelligence by default, but has an independent model and timeout boundary.
CREATIVE_DIRECTOR_PROVIDER=gemini
# Leave unset to use gemini-3.6-flash.
# CREATIVE_DIRECTOR_MODEL=
CREATIVE_DIRECTOR_TIMEOUT_MS=300000

# Task 011 deterministic FFmpeg rendering. Rendering is local worker compute;
# it never calls an AI provider and is recorded separately from AiRun costs.
RENDER_ATTEMPTS=2
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_MS=1800000
RENDER_MAX_OUTPUT_BYTES=2147483648

# Application URLs used for metadata, links, and service discovery.
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

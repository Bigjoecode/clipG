# Local PostgreSQL used by Prisma and future API database access.
DATABASE_URL=postgresql://clipgenius:clipgenius@localhost:5432/clipgenius

# Supabase Auth public configuration. The publishable key is safe for browser use;
# never put a Supabase secret/service-role key in a NEXT_PUBLIC variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local Redis used by the background worker.
REDIS_URL=redis://localhost:6379

# Application URLs used for metadata, links, and service discovery.
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

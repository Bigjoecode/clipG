generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("organization_role")
}

enum ProjectStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("project_status")
}

enum MediaKind {
  SOURCE_VIDEO @map("source_video")

  @@map("media_kind")
}

enum MediaStatus {
  UPLOAD_PENDING @map("upload_pending")
  UPLOADED       @map("uploaded")
  FAILED         @map("failed")

  @@map("media_status")
}

enum MediaJobType {
  MEDIA_PROBE          @map("media_probe")
  TRANSCRIPTION        @map("transcription")
  CONTENT_INTELLIGENCE @map("content_intelligence")
  CREATIVE_DIRECTOR    @map("creative_director")

  @@map("media_job_type")
}

enum ContentOpportunityType {
  STORY              @map("story")
  ARGUMENT           @map("argument")
  INSIGHT            @map("insight")
  QUESTION_ANSWER    @map("question_answer")
  QUOTE              @map("quote")
  HOOK               @map("hook")
  CALL_TO_ACTION     @map("call_to_action")
  EMOTIONAL_MOMENT   @map("emotional_moment")
  VISUAL_OPPORTUNITY @map("visual_opportunity")

  @@map("content_opportunity_type")
}

enum ContentPlatform {
  YOUTUBE   @map("youtube")
  INSTAGRAM @map("instagram")
  TIKTOK    @map("tiktok")
  FACEBOOK  @map("facebook")

  @@map("content_platform")
}

enum MediaJobStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("media_job_status")
}

enum AiOperation {
  TRANSCRIPTION        @map("transcription")
  CONTENT_INTELLIGENCE @map("content_intelligence")
  CREATIVE_DIRECTOR    @map("creative_director")

  @@map("ai_operation")
}

enum AiRunStatus {
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("ai_run_status")
}

enum AiErrorCategory {
  AUTHENTICATION       @map("authentication")
  CONTENT_POLICY       @map("content_policy")
  INVALID_REQUEST      @map("invalid_request")
  INVALID_RESPONSE     @map("invalid_response")
  PROVIDER_UNAVAILABLE @map("provider_unavailable")
  QUOTA                @map("quota")
  RATE_LIMIT           @map("rate_limit")
  TIMEOUT              @map("timeout")
  UNKNOWN              @map("unknown")

  @@map("ai_error_category")
}

enum RenderStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("render_status")
}

enum RenderErrorCategory {
  INVALID_EDIT_PLAN     @map("invalid_edit_plan")
  MISSING_SOURCE_MEDIA  @map("missing_source_media")
  MISSING_ASSET         @map("missing_asset")
  UNSUPPORTED_OPERATION @map("unsupported_operation")
  UNSUPPORTED_CODEC     @map("unsupported_codec")
  RENDERER_FAILURE      @map("renderer_failure")
  STORAGE_FAILURE       @map("storage_failure")
  TIMEOUT               @map("timeout")

  @@map("render_error_category")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  displayName     String?   @map("display_name") @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  createdProjects         Project[]                @relation("ProjectCreator")
  uploadedMedia           MediaAsset[]             @relation("MediaUploader")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(63)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          OrganizationMembership[]
  projects             Project[]
  mediaAssets          MediaAsset[]
  mediaJobs            MediaJob[]
  transcripts          Transcript[]
  contentAnalyses      ContentAnalysis[]
  contentOpportunities ContentOpportunity[]
  aiRuns               AiRun[]
  renders              Render[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  name           String        @db.VarChar(120)
  description    String?       @db.Text
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy            User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mediaAssets          MediaAsset[]
  mediaJobs            MediaJob[]
  transcripts          Transcript[]
  contentAnalyses      ContentAnalysis[]
  contentOpportunities ContentOpportunity[]
  aiRuns               AiRun[]
  renders              Render[]

  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("projects")
}

model MediaAsset {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  uploadedById    String?     @map("uploaded_by_id") @db.Uuid
  kind            MediaKind   @default(SOURCE_VIDEO)
  status          MediaStatus @default(UPLOAD_PENDING)
  originalName    String      @map("original_name") @db.VarChar(255)
  contentType     String      @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt      @map("size_bytes")
  storageProvider String      @map("storage_provider") @db.VarChar(32)
  storageBucket   String      @map("storage_bucket") @db.VarChar(100)
  storageKey      String      @map("storage_key") @db.Text
  failureReason   String?     @map("failure_reason") @db.VarChar(255)
  uploadedAt      DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Technical facts derived from the stored object by ffprobe. They describe the
  // immutable source rather than replacing it, and stay null until a media probe
  // job succeeds.
  durationSeconds Float?    @map("duration_seconds")
  width           Int?
  height          Int?
  videoCodec      String?   @map("video_codec") @db.VarChar(64)
  audioCodec      String?   @map("audio_codec") @db.VarChar(64)
  frameRate       Float?    @map("frame_rate")
  bitRate         Int?      @map("bit_rate")
  hasAudio        Boolean?  @map("has_audio")
  probedAt        DateTime? @map("probed_at") @db.Timestamptz(3)

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy           User?                @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs                 MediaJob[]
  transcript           Transcript?
  contentAnalysis      ContentAnalysis?
  contentOpportunities ContentOpportunity[]
  aiRuns               AiRun[]
  renders              Render[]

  @@unique([storageProvider, storageBucket, storageKey])
  @@index([organizationId, createdAt])
  @@index([projectId, status])
  @@index([uploadedById])
  @@map("media_assets")
}

model MediaJob {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  mediaAssetId   String         @map("media_asset_id") @db.Uuid
  type           MediaJobType
  status         MediaJobStatus @default(QUEUED)
  attempts       Int            @default(0)
  failureReason  String?        @map("failure_reason") @db.VarChar(500)
  queuedAt       DateTime       @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  aiRuns       AiRun[]

  // One job of each type per media asset. This is the idempotency key that makes
  // a repeated completion call reuse the existing job instead of queueing again.
  @@unique([mediaAssetId, type])
  @@index([organizationId, createdAt])
  @@index([status, queuedAt])
  @@map("media_jobs")
}

/**
 * Append-only record of one actual external AI provider attempt. Pricing rates
 * are copied onto the row so a future catalog update cannot rewrite history.
 */
model AiRun {
  id                                String           @id @default(uuid()) @db.Uuid
  organizationId                    String           @map("organization_id") @db.Uuid
  projectId                         String?          @map("project_id") @db.Uuid
  mediaAssetId                      String?          @map("media_asset_id") @db.Uuid
  mediaJobId                        String?          @map("media_job_id") @db.Uuid
  operation                         AiOperation
  stage                             String           @default("LEGACY") @db.VarChar(32)
  provider                          String           @db.VarChar(32)
  model                             String           @db.VarChar(100)
  status                            AiRunStatus
  attempt                           Int
  inputTokens                       Int?             @map("input_tokens")
  outputTokens                      Int?             @map("output_tokens")
  cachedTokens                      Int?             @map("cached_tokens")
  cacheWriteTokens                  Int?             @map("cache_write_tokens")
  reasoningTokens                   Int?             @map("reasoning_tokens")
  audioSeconds                      Float?           @map("audio_seconds")
  latencyMs                         Int              @map("latency_ms")
  providerRequestId                 String?          @map("provider_request_id") @db.VarChar(255)
  errorCategory                     AiErrorCategory? @map("error_category")
  estimatedCostMicros               BigInt?          @map("estimated_cost_micros")
  actualCostMicros                  BigInt?          @map("actual_cost_micros")
  pricingVersion                    String?          @map("pricing_version") @db.VarChar(100)
  pricingSourceUrl                  String?          @map("pricing_source_url") @db.Text
  pricingEffectiveFrom              DateTime?        @map("pricing_effective_from") @db.Date
  pricingEffectiveThrough           DateTime?        @map("pricing_effective_through") @db.Date
  inputMicrosPerMillionTokens       Int?             @map("input_micros_per_million_tokens")
  outputMicrosPerMillionTokens      Int?             @map("output_micros_per_million_tokens")
  cachedInputMicrosPerMillionTokens Int?             @map("cached_input_micros_per_million_tokens")
  cacheWriteMicrosPerMillionTokens  Int?             @map("cache_write_micros_per_million_tokens")
  audioMicrosPerMinute              Int?             @map("audio_micros_per_minute")
  createdAt                         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mediaJob     MediaJob?    @relation(fields: [mediaJobId], references: [id], onDelete: SetNull)

  @@unique([mediaJobId, attempt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([operation, provider, model, createdAt])
  @@index([operation, stage, createdAt])
  @@map("ai_runs")
}

model Transcript {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  mediaAssetId    String   @unique @map("media_asset_id") @db.Uuid
  provider        String   @db.VarChar(32)
  model           String   @db.VarChar(100)
  language        String?  @db.VarChar(16)
  text            String   @db.Text
  durationSeconds Float?   @map("duration_seconds")
  // Whether the provider actually attributed speech to speakers. Without this a
  // null segment speaker is ambiguous: it could mean the provider cannot
  // diarize at all, or that it diarized but left one segment unattributed.
  // Content intelligence must be able to tell those apart.
  diarized        Boolean  @default(false)
  speakerCount    Int?     @map("speaker_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  segments        TranscriptSegment[]
  contentAnalysis ContentAnalysis?

  @@index([organizationId, createdAt])
  @@index([projectId, updatedAt])
  @@map("transcripts")
}

model ContentAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  mediaAssetId        String   @unique @map("media_asset_id") @db.Uuid
  transcriptId        String   @unique @map("transcript_id") @db.Uuid
  provider            String   @db.VarChar(32)
  model               String   @db.VarChar(100)
  promptId            String   @map("prompt_id") @db.VarChar(100)
  promptVersion       Int      @map("prompt_version")
  transcriptUpdatedAt DateTime @map("transcript_updated_at") @db.Timestamptz(3)
  summary             String   @db.Text
  topics              String[] @default([])
  keywords            String[] @default([])
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  transcript    Transcript           @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  opportunities ContentOpportunity[]

  @@index([organizationId, createdAt])
  @@index([projectId, updatedAt])
  @@map("content_analyses")
}

model ContentOpportunity {
  id                         String                 @id @default(uuid()) @db.Uuid
  analysisId                 String                 @map("analysis_id") @db.Uuid
  organizationId             String                 @map("organization_id") @db.Uuid
  projectId                  String                 @map("project_id") @db.Uuid
  mediaAssetId               String                 @map("media_asset_id") @db.Uuid
  index                      Int
  type                       ContentOpportunityType
  title                      String                 @db.VarChar(160)
  topic                      String                 @db.VarChar(160)
  hook                       String                 @db.VarChar(280)
  summary                    String                 @db.Text
  rationale                  String                 @db.Text
  evidenceText               String                 @map("evidence_text") @db.Text
  startSeconds               Float                  @map("start_seconds")
  endSeconds                 Float                  @map("end_seconds")
  recommendedDurationSeconds Int                    @map("recommended_duration_seconds")
  recommendedPlatforms       ContentPlatform[]      @map("recommended_platforms")
  hookScore                  Int                    @map("hook_score")
  clarityScore               Int                    @map("clarity_score")
  emotionalImpactScore       Int                    @map("emotional_impact_score")
  standaloneValueScore       Int                    @map("standalone_value_score")
  retentionPotentialScore    Int                    @map("retention_potential_score")
  platformFitScore           Int                    @map("platform_fit_score")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  analysis     ContentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([analysisId, index])
  @@index([mediaAssetId, startSeconds])
  @@index([projectId, type])
  @@map("content_opportunities")
}

model TranscriptSegment {
  id           String   @id @default(uuid()) @db.Uuid
  transcriptId String   @map("transcript_id") @db.Uuid
  index        Int
  startSeconds Float    @map("start_seconds")
  endSeconds   Float    @map("end_seconds")
  speaker      String?  @db.VarChar(64)
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, index])
  @@index([transcriptId, startSeconds])
  @@map("transcript_segments")
}

/**
 * One immutable rendering intent and its output. The plan and resolved asset
 * manifest are snapshotted so a replay executes the same inputs; media bytes
 * remain in object storage rather than PostgreSQL.
 */
model Render {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  projectId              String               @map("project_id") @db.Uuid
  sourceMediaAssetId     String               @map("source_media_asset_id") @db.Uuid
  idempotencyKey         String               @map("idempotency_key") @db.Char(64)
  editPlan               Json                 @map("edit_plan")
  assetManifest          Json                 @map("asset_manifest")
  allowAiGeneratedAssets Boolean              @default(false) @map("allow_ai_generated_assets")
  status                 RenderStatus         @default(QUEUED)
  attempts               Int                  @default(0)
  backend                String?              @db.VarChar(32)
  rendererVersion        String?              @map("renderer_version") @db.VarChar(32)
  outputBucket           String?              @map("output_bucket") @db.VarChar(100)
  outputKey              String?              @map("output_key") @db.Text
  outputContentType      String?              @map("output_content_type") @db.VarChar(100)
  outputSizeBytes        BigInt?              @map("output_size_bytes")
  outputDurationMs       Int?                 @map("output_duration_ms")
  outputWidth            Int?                 @map("output_width")
  outputHeight           Int?                 @map("output_height")
  outputVideoCodec       String?              @map("output_video_codec") @db.VarChar(64)
  outputAudioCodec       String?              @map("output_audio_codec") @db.VarChar(64)
  renderDurationMs       Int?                 @map("render_duration_ms")
  errorCategory          RenderErrorCategory? @map("error_category")
  failureReason          String?              @map("failure_reason") @db.VarChar(500)
  queuedAt               DateTime             @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt              DateTime?            @map("started_at") @db.Timestamptz(3)
  finishedAt             DateTime?            @map("finished_at") @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceMedia  MediaAsset   @relation(fields: [sourceMediaAssetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([status, queuedAt])
  @@map("renders")
}

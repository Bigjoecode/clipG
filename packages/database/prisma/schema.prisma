generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("organization_role")
}

enum ProjectStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("project_status")
}

enum MediaKind {
  SOURCE_VIDEO @map("source_video")

  @@map("media_kind")
}

enum MediaStatus {
  UPLOAD_PENDING @map("upload_pending")
  UPLOADED       @map("uploaded")
  FAILED         @map("failed")

  @@map("media_status")
}

enum MediaJobType {
  MEDIA_PROBE   @map("media_probe")
  TRANSCRIPTION @map("transcription")

  @@map("media_job_type")
}

enum MediaJobStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("media_job_status")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  displayName     String?   @map("display_name") @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  createdProjects         Project[]                @relation("ProjectCreator")
  uploadedMedia           MediaAsset[]             @relation("MediaUploader")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(63)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMembership[]
  projects    Project[]
  mediaAssets MediaAsset[]
  mediaJobs   MediaJob[]
  transcripts Transcript[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  name           String        @db.VarChar(120)
  description    String?       @db.Text
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mediaAssets  MediaAsset[]
  mediaJobs    MediaJob[]
  transcripts  Transcript[]

  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("projects")
}

model MediaAsset {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  uploadedById    String?     @map("uploaded_by_id") @db.Uuid
  kind            MediaKind   @default(SOURCE_VIDEO)
  status          MediaStatus @default(UPLOAD_PENDING)
  originalName    String      @map("original_name") @db.VarChar(255)
  contentType     String      @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt      @map("size_bytes")
  storageProvider String      @map("storage_provider") @db.VarChar(32)
  storageBucket   String      @map("storage_bucket") @db.VarChar(100)
  storageKey      String      @map("storage_key") @db.Text
  failureReason   String?     @map("failure_reason") @db.VarChar(255)
  uploadedAt      DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Technical facts derived from the stored object by ffprobe. They describe the
  // immutable source rather than replacing it, and stay null until a media probe
  // job succeeds.
  durationSeconds Float?    @map("duration_seconds")
  width           Int?
  height          Int?
  videoCodec      String?   @map("video_codec") @db.VarChar(64)
  audioCodec      String?   @map("audio_codec") @db.VarChar(64)
  frameRate       Float?    @map("frame_rate")
  bitRate         Int?      @map("bit_rate")
  hasAudio        Boolean?  @map("has_audio")
  probedAt        DateTime? @map("probed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs         MediaJob[]
  transcript   Transcript?

  @@unique([storageProvider, storageBucket, storageKey])
  @@index([organizationId, createdAt])
  @@index([projectId, status])
  @@index([uploadedById])
  @@map("media_assets")
}

model MediaJob {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  mediaAssetId   String         @map("media_asset_id") @db.Uuid
  type           MediaJobType
  status         MediaJobStatus @default(QUEUED)
  attempts       Int            @default(0)
  failureReason  String?        @map("failure_reason") @db.VarChar(500)
  queuedAt       DateTime       @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  // One job of each type per media asset. This is the idempotency key that makes
  // a repeated completion call reuse the existing job instead of queueing again.
  @@unique([mediaAssetId, type])
  @@index([organizationId, createdAt])
  @@index([status, queuedAt])
  @@map("media_jobs")
}

model Transcript {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  mediaAssetId    String   @unique @map("media_asset_id") @db.Uuid
  provider        String   @db.VarChar(32)
  model           String   @db.VarChar(100)
  language        String?  @db.VarChar(16)
  text            String   @db.Text
  durationSeconds Float?   @map("duration_seconds")
  // Whether the provider actually attributed speech to speakers. Without this a
  // null segment speaker is ambiguous: it could mean the provider cannot
  // diarize at all, or that it diarized but left one segment unattributed.
  // Content intelligence must be able to tell those apart.
  diarized        Boolean  @default(false)
  speakerCount    Int?     @map("speaker_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  segments     TranscriptSegment[]

  @@index([organizationId, createdAt])
  @@index([projectId, updatedAt])
  @@map("transcripts")
}

model TranscriptSegment {
  id           String   @id @default(uuid()) @db.Uuid
  transcriptId String   @map("transcript_id") @db.Uuid
  index        Int
  startSeconds Float    @map("start_seconds")
  endSeconds   Float    @map("end_seconds")
  speaker      String?  @db.VarChar(64)
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, index])
  @@index([transcriptId, startSeconds])
  @@map("transcript_segments")
}

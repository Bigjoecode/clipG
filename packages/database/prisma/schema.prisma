generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("organization_role")
}

enum ProjectStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("project_status")
}

enum MediaKind {
  SOURCE_VIDEO @map("source_video")

  @@map("media_kind")
}

enum MediaStatus {
  UPLOAD_PENDING @map("upload_pending")
  UPLOADED       @map("uploaded")
  FAILED         @map("failed")

  @@map("media_status")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  displayName     String?   @map("display_name") @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[]
  createdProjects         Project[]                @relation("ProjectCreator")
  uploadedMedia           MediaAsset[]             @relation("MediaUploader")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(63)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMembership[]
  projects    Project[]
  mediaAssets MediaAsset[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  name           String        @db.VarChar(120)
  description    String?       @db.Text
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mediaAssets  MediaAsset[]

  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("projects")
}

model MediaAsset {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  uploadedById    String?     @map("uploaded_by_id") @db.Uuid
  kind            MediaKind   @default(SOURCE_VIDEO)
  status          MediaStatus @default(UPLOAD_PENDING)
  originalName    String      @map("original_name") @db.VarChar(255)
  contentType     String      @map("content_type") @db.VarChar(100)
  sizeBytes       BigInt      @map("size_bytes")
  storageProvider String      @map("storage_provider") @db.VarChar(32)
  storageBucket   String      @map("storage_bucket") @db.VarChar(100)
  storageKey      String      @map("storage_key") @db.Text
  failureReason   String?     @map("failure_reason") @db.VarChar(255)
  uploadedAt      DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([storageProvider, storageBucket, storageKey])
  @@index([organizationId, createdAt])
  @@index([projectId, status])
  @@index([uploadedById])
  @@map("media_assets")
}

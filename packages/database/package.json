{
  "name": "@clipgenius/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "corepack pnpm generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "prisma generate",
    "lint": "eslint src prisma.config.ts",
    "typecheck": "corepack pnpm generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}

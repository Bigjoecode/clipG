{
  "name": "@clipgenius/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "corepack pnpm generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "format": "prisma format",
    "generate": "prisma generate",
    "lint": "eslint src test prisma.config.ts",
    "migrate:deploy": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "pretest": "corepack pnpm --filter @clipgenius/types build",
    "test": "corepack pnpm generate && vitest run",
    "validate": "prisma validate",
    "typecheck": "corepack pnpm generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@clipgenius/types": "workspace:*",
    "@types/pg": "^8.23.1",
    "prisma": "7.9.1",
    "vitest": "^4.1.11"
  }
}

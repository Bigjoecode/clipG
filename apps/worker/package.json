{
  "name": "@clipgenius/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env --watch --enable-source-maps --import tsx src/main.ts",
    "lint": "eslint src test",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clipgenius/config": "workspace:*",
    "@clipgenius/database": "workspace:*",
    "@clipgenius/storage": "workspace:*",
    "@clipgenius/types": "workspace:*",
    "@clipgenius/video": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@supabase/supabase-js": "2.112.4",
    "bullmq": "^6.2.0",
    "ioredis": "5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "vitest": "4.1.11"
  }
}
